{
  "expo": {
    "name": "Univerin",
    "slug": "univerin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#1669ef"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.univerin.app",
      "config": {
        "googleMapsApiKey": "AIzaSyCS_YRu6O61LCZn_QlypzjcjSdeRqbQaDI"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Univerin needs your location to show nearby delivery orders and track deliveries.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Univerin needs background location access so we can match you with nearby orders even when the app is not open.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.univerin.app",
      "adaptiveIcon": {
        "backgroundColor": "#1669ef",
        "foregroundImage": "./assets/app-icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCS_YRu6O61LCZn_QlypzjcjSdeRqbQaDI"
        }
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0685df21-5304-446c-b78b-1387b0c5abb9"
    },
    "owner": "thanurvika",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icon.png",
          "color": "#1669ef"
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "android": {
            "googleServicesFile": "./google-services.json"
          }
        }
      ],
      "@react-native-firebase/auth",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Univerin needs background location access so we can match you with nearby orders even when the app is not open.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0685df21-5304-446c-b78b-1387b0c5abb9"
      }
    }
  }
}
